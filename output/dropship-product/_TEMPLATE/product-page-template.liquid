.bm-reborn-video-transition__eyebrow-text{font-family:'Heebo',sans-serif;font-size:11px;font-weight:700;color:rgba(184,149,106,0.75);letter-spacing:0.13em;text-transform:uppercase;}
.bm-reborn-video-transition__headline{font-family:'Heebo',sans-serif;font-size:clamp(26px,3vw,44px);font-weight:900;color:#1F1B16;line-height:1.2;margin:0 0 16px;letter-spacing:-0.01em;}
