.bm-reborn-research__eyebrow-line{height:1px;width:40px;background:rgba(184,149,106,0.4);}
.bm-reborn-research__eyebrow-text{font-family:'Heebo',sans-serif;font-size:11px;font-weight:700;color:rgba(184,149,106,0.75);letter-spacing:0.13em;text-transform:uppercase;}
.bm-reborn-research__headline{font-family:'Heebo',sans-serif;font-size:clamp(28px,3.2vw,48px);font-weight:900;color:#1F1B16;line-height:1.18;text-align:center;margin:0 0 20px;letter-spacing:-0.01em;}
.bm-reborn-research__intro{font-family:'Heebo',sans-serif;font-size:16px;color:#5c4e40;text-align:center;margin:0 auto 52px;max-width:600px;line-height:1.8;}
