{% javascript %}
(function () {
  /* ── S1 Trust Bar — IntersectionObserver fade-in ── */
  var trust = document.getElementById('bm-hero-trust');
  if (trust) {
    if (!('IntersectionObserver' in window)) {
      trust.classList.add('bm-trust--visible');
    } else {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('bm-trust--visible');
            this.unobserve(e.target);
          }
        }.bind(this));
      }, { threshold: 0.1 }).observe(trust);
    }
  }

  /* ── S17 Countdown — localStorage-based 10-minute session timer ── */
  var KEY = 'bm_reborn_cd_deadline';
  var DURATION = 10 * 60 * 1000;
  var now = Date.now();
  var deadline = parseInt(localStorage.getItem(KEY) || '0', 10);
  if (!deadline || deadline <= now) {
    deadline = now + DURATION;
    try { localStorage.setItem(KEY, deadline); } catch (e) {}
  }

  var elH = document.getElementById('bm-cd-h');
  var elM = document.getElementById('bm-cd-m');
  var elS = document.getElementById('bm-cd-s');
  if (!elH || !elM || !elS) return;

  function pad(n) { return String(n).padStart(2, '0'); }

  function tick() {
    var remaining = Math.max(0, deadline - Date.now());
    elH.textContent = pad(Math.floor(remaining / 3600000));
    elM.textContent = pad(Math.floor((remaining % 3600000) / 60000));
    elS.textContent = pad(Math.floor((remaining % 60000) / 1000));
    if (remaining <= 0) {
      deadline = Date.now() + DURATION;
      try { localStorage.setItem(KEY, deadline); } catch (e) {}
    }
  }

  tick();
  setInterval(tick, 1000);
}());
{% endjavascript %}

