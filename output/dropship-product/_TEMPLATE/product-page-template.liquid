/* ── S8 BEFORE/AFTER ── */
.ba-sec { background:var(--bg-alt); padding:80px 0; }
.ba-sec h2 { font-size:clamp(20px,2.8vw,30px); font-weight:900; color:var(--heading); text-align:center; margin-bottom:36px; }
.ba-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; margin-bottom:28px; }
@media(max-width:768px){ .ba-grid{grid-template-columns:1fr;} }
.ba-before { aspect-ratio:4/3; background:#E8EEF4; border-radius:16px; display:flex; align-items:center; justify-content:center; color:#999; font-size:16px; font-weight:700; border:2px dashed #B0C4D8; }
.ba-after { aspect-ratio:4/3; background:#EDF7EE; border-radius:16px; display:flex; align-items:center; justify-content:center; color:var(--save-text); font-size:16px; font-weight:700; border:2px dashed #90C095; }
.ba-caption { text-align:center; font-size:15px; color:var(--text); max-width:580px; margin:0 auto; line-height:1.7; }

/* ── S11+12 PREMIUM SOCIAL PROOF CTA ── */
.premium-section { background-color:#1a1614; padding:4rem 2rem; width:100%; text-align:center; display:flex; flex-direction:column; align-items:center; gap:2rem; }
.premium-section .trust-badge { display:inline-flex; align-items:center; gap:0.5rem; border:1px solid #b8956a; padding:0.5rem 1.25rem; border-radius:9999px; color:#a39a95; font-size:0.9rem; font-weight:500; }
.premium-section .trust-badge svg { width:1.25rem; height:1.25rem; fill:#b8956a; }
.premium-section .headline { font-size:clamp(2rem,4vw,2.5rem); font-weight:700; line-height:1.2; color:#fcf9f8; font-family:'Heebo',sans-serif; }
.premium-section .headline .highlight { color:#b8956a; }
.premium-section .divider-container { display:flex; align-items:center; width:100%; max-width:400px; margin:0 auto; gap:1rem; }
.premium-section .divider-line { flex-grow:1; height:1px; background-color:rgba(184,149,106,0.3); }
.premium-section .divider-icon svg { width:1rem; height:1rem; fill:#b8956a; }
.premium-section .description { font-size:1.25rem; line-height:1.6; max-width:600px; margin:0 auto; color:#fcf9f8; font-weight:500; font-family:'Heebo',sans-serif; }
.premium-section .rating-section { display:flex; align-items:center; justify-content:center; gap:1.5rem; margin-top:0.5rem; flex-wrap:wrap; }
.premium-section .stars-container { display:flex; align-items:center; gap:0.5rem; }
.premium-section .stars { display:flex; gap:0.25rem; }
.premium-section .stars svg { width:1.25rem; height:1.25rem; fill:#b8956a; }
.premium-section .rating-text { font-size:1.1rem; color:#a39a95; }
.premium-section .rating-separator { width:1px; height:20px; background-color:rgba(184,149,106,0.3); }
.premium-section .reviews-count { display:flex; align-items:center; gap:0.5rem; font-size:1.1rem; color:#a39a95; }
.premium-section .reviews-count svg { width:1.25rem; height:1.25rem; stroke:#b8956a; fill:none; stroke-width:1.5; }
.premium-section .ps-cta { display:inline-flex; align-items:center; justify-content:center; gap:0.75rem; background:linear-gradient(135deg,#b8956a,#dbb88d); color:#fff; font-size:1.25rem; font-weight:700; padding:1rem 3rem; border-radius:9999px; border:1px solid rgba(255,255,255,0.2); box-shadow:0 0 20px rgba(184,149,106,0.4); transition:all 0.3s ease; cursor:pointer; font-family:'Heebo',sans-serif; }
.premium-section .ps-cta:hover { transform:translateY(-2px); box-shadow:0 0 30px rgba(184,149,106,0.6); background:linear-gradient(135deg,#dbb88d,#b8956a); }
.premium-section .ps-cta svg { width:1.5rem; height:1.5rem; stroke:currentColor; fill:none; stroke-width:2; }
.premium-section .features-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; width:100%; max-width:860px; padding-top:2rem; border-top:1px solid rgba(184,149,106,0.3); }
.premium-section .feature-item { display:flex; align-items:flex-start; gap:1rem; text-align:right; }
.premium-section .feature-icon { flex-shrink:0; display:flex; align-items:center; justify-content:center; }
.premium-section .feature-icon svg { width:2.5rem; height:2.5rem; stroke:#b8956a; fill:none; stroke-width:1.5; }
.premium-section .feature-content { display:flex; flex-direction:column; gap:0.25rem; }
.premium-section .feature-title { font-size:1.1rem; font-weight:600; color:#fcf9f8; }
.premium-section .feature-desc { font-size:0.9rem; color:#a39a95; }
@media(max-width:768px){
  .premium-section .headline { font-size:2rem; }
  .premium-section .features-grid { grid-template-columns:repeat(3,1fr); gap:0.75rem; }
  .premium-section .feature-item { align-items:center; text-align:center; flex-direction:column; }
  .premium-section .feature-icon svg { width:1.75rem; height:1.75rem; }
  .premium-section .feature-title { font-size:0.85rem; }
  .premium-section .feature-desc { font-size:0.75rem; }
  .premium-section .ps-cta { width:100%; padding:1rem 2rem; }
  .premium-section .rating-section { flex-direction:column; gap:0.75rem; }
  .premium-section .rating-separator { display:none; }
}

/* ── S13 STATS ── */
.stats-sec { background:var(--bg); padding:60px 0; }
.stats-grid { display:flex; flex-wrap:wrap; justify-content:center; gap:40px; }
.stat-blk { text-align:center; min-width:130px; }
.stat-num { font-size:36px; font-weight:900; color:var(--cta); display:block; }
.stat-num.gold { color:var(--stars); }
.stat-lbl { font-size:14px; color:var(--text); margin-top:4px; }

/* ── S13+14 WHO FOR ── */
.whofor-section { background:var(--bg); padding:64px 0 80px; }
.whofor-cards-outer { position:relative; }
.whofor-cards-container { overflow-x:auto; padding:16px 4px; margin:0 -4px; scrollbar-width:none; -ms-overflow-style:none; }
.whofor-cards-container::-webkit-scrollbar { display:none; }
#whofor-cards { display:flex; gap:24px; scroll-snap-type:x mandatory; }
#whofor-cards article { flex:none; width:210px; scroll-snap-align:center; background:#fff; border-radius:14px; border:1px solid #e0e0e0; box-shadow:0 1px 4px rgba(0,0,0,0.08); overflow:hidden; display:flex; flex-direction:column; transition:box-shadow .3s; }
#whofor-cards article:hover { box-shadow:0 6px 20px rgba(0,0,0,0.12); }
.whofor-card-img { position:relative; padding:6px; height:170px; }
.whofor-card-img img { width:100%; height:100%; object-fit:cover; border-radius:10px; }
.whofor-age-badge { position:absolute; bottom:12px; left:12px; background:var(--cta); color:#fff; font-weight:700; font-size:12px; padding:4px 10px; border-radius:9999px; }
.whofor-card-body { padding:14px 16px; text-align:center; flex-grow:1; display:flex; flex-direction:column; justify-content:center; }
.whofor-card-title { font-size:15px; font-weight:700; margin-bottom:5px; color:var(--heading); font-family:'Heebo',sans-serif; }
.whofor-card-desc { font-size:12px; color:var(--text); line-height:1.6; }
.whofor-nav-btn { display:none; position:absolute; top:50%; transform:translateY(-50%); width:44px; height:44px; background:#fff; border-radius:50%; box-shadow:0 2px 8px rgba(0,0,0,0.12); align-items:center; justify-content:center; border:1px solid #e0e0e0; cursor:pointer; z-index:10; color:var(--text); transition:all .2s; }
.whofor-nav-btn:hover { color:var(--cta); background:var(--bg-alt); }
.whofor-nav-prev { right:-20px; }
.whofor-nav-next { left:-20px; }
.whofor-dots { display:flex; justify-content:center; gap:10px; margin-top:28px; }
.whofor-dot { width:10px; height:10px; border-radius:50%; background:#dcd9d9; cursor:pointer; transition:background .2s; }
.whofor-dot.active { background:#d99e98; width:12px; height:12px; }
@media(min-width:768px){ .whofor-nav-btn{display:flex;} }
@media(max-width:767px){
  .whofor-cards-container { overflow:visible; padding:0; margin:0; }
  #whofor-cards { display:grid; grid-template-columns:1fr 1fr; gap:14px; scroll-snap-type:unset; }
  #whofor-cards article { width:auto; }
  #whofor-cards article:nth-child(5) { display:none; }
  .whofor-card-img { height:auto; aspect-ratio:1/1; }
  .whofor-card-body { padding:14px; }
  .whofor-card-title { font-size:15px; }
  .whofor-dots { display:none; }
}


/* ── S15 PRICE COMPARE ── */
.pricecmp-sec { background:var(--bg); padding:80px 0; }
.pricecmp-sec h2 { font-size:clamp(22px,3vw,34px); font-weight:900; color:var(--heading); text-align:center; margin-bottom:12px; }
.pricecmp-intro { font-size:16px; color:var(--text); text-align:center; margin-bottom:36px; }
.cmp-rows { display:flex; flex-direction:column; gap:12px; max-width:580px; margin:0 auto 36px; }
.cmp-row { background:var(--bg-alt); border-radius:8px; padding:14px 20px; display:flex; justify-content:space-between; align-items:center; flex-direction:row-reverse; }
.cmp-label { font-size:15px; color:var(--text); text-align:right; }
.cmp-price { font-size:18px; font-weight:700; color:#E65100; }
.price-hl { border:2px solid var(--cta); border-radius:16px; padding:32px 24px; text-align:center; background:var(--bg-alt); max-width:460px; margin:0 auto 24px; }
.price-hl-product { font-size:20px; font-weight:700; color:var(--heading); margin-bottom:10px; }
.price-hl-price { font-size:28px; font-weight:900; color:var(--cta); margin-bottom:8px; }
.price-hl-once { font-size:15px; color:var(--text); margin-bottom:4px; }
.price-hl-daily { font-size:14px; color:var(--text); margin-bottom:4px; }
.price-hl-years { font-size:15px; font-weight:600; color:var(--text); }
.pricecmp-close { text-align:center; font-size:17px; font-weight:700; color:var(--heading); }

/* ── S17 FINAL CTA ── */
.finalcta-sec { background:#1A1A1A; padding:100px 0; text-align:center; }
.finalcta-sec h2 { font-size:clamp(24px,3.5vw,38px); font-weight:900; color:#fff; margin-bottom:14px; line-height:1.35; }
.finalcta-txt { font-size:17px; color:rgba(255,255,255,0.8); margin-bottom:28px; }
.finalcta-price-row { display:flex; align-items:center; gap:12px; justify-content:center; margin-bottom:22px; }
.finalcta-price-now { font-size:40px; font-weight:900; color:#fff; }
.finalcta-price-old { font-size:22px; color:rgba(255,255,255,0.4); text-decoration:line-through; }
.finalcta-price-save { background:rgba(46,125,50,0.85); color:#fff; font-size:13px; font-weight:700; padding:5px 14px; border-radius:20px; }
.finalcta-countdown { display:flex; gap:8px; justify-content:center; align-items:flex-end; margin-bottom:30px; }
.bm-cd-unit { display:flex; flex-direction:column; align-items:center; gap:4px; }
.bm-cd-lbl { font-size:11px; color:rgba(255,255,255,0.55); text-align:center; }
.bm-cd-num { background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.14); border-radius:8px; padding:8px 14px; min-width:50px; text-align:center; }
.bm-cd-num span { font-size:22px; font-weight:900; color:#fff; display:block; font-variant-numeric:tabular-nums; }
.bm-cd-sep { font-size:22px; font-weight:700; color:rgba(255,255,255,0.45); line-height:1; padding-bottom:16px; }
@keyframes bm-glow-pulse { 0%,100%{box-shadow:0 4px 16px rgba(184,149,106,0.2);} 50%{box-shadow:0 0 28px 10px rgba(184,149,106,0.5);} }
.btn-cta--glow { animation:bm-glow-pulse 2.2s ease-in-out infinite; }
.finalcta-btns { display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-bottom:28px; }
.btn-outline-white { display:inline-block; background:transparent; color:#fff; font-family:'Heebo',sans-serif; font-weight:700; font-size:18px; padding:14px 36px; border-radius:50px; border:2px solid #fff; cursor:pointer; text-decoration:none; transition:background .2s; }
.btn-outline-white:hover { background:rgba(255,255,255,0.12); }
.finalcta-badges { display:flex; gap:18px; justify-content:center; flex-wrap:wrap; margin-bottom:28px; }
.finalcta-badge-svg { display:flex; align-items:center; gap:6px; font-size:13px; color:rgba(255,255,255,0.8); }
.finalcta-badge-svg svg { width:17px; height:17px; fill:none; stroke:rgba(255,255,255,0.7); stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
.finalcta-close { font-size:15px; color:rgba(255,255,255,0.5); font-style:italic; }
