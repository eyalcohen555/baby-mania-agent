/* ── S7.5 VIDEO TRANSITION ── */
.bm-reborn-video-transition{background:#F6EFE6;padding:80px 0;direction:rtl;}
.bm-reborn-video-transition__inner{max-width:1040px;margin:0 auto;padding:0 36px;text-align:center;}
