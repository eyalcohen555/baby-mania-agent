.bm-reborn-problem__eyebrow{font-family:'Heebo',sans-serif;font-size:11px;font-weight:700;color:rgba(184,149,106,0.7);letter-spacing:0.12em;text-transform:uppercase;text-align:right;margin-bottom:20px;display:flex;align-items:center;gap:10px;justify-content:flex-end;}
.bm-reborn-problem__eyebrow::before{content:'';display:inline-block;width:20px;height:1px;background:rgba(184,149,106,0.45);}
.bm-reborn-problem__grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
.bm-reborn-problem__text{display:flex;flex-direction:column;gap:22px;text-align:center;}
.bm-reborn-problem__headline{font-family:'Heebo',sans-serif;font-size:clamp(36px,4.5vw,56px);font-weight:900;color:#1F1B16;line-height:1.1;letter-spacing:-0.02em;margin:0;text-align:center;}
.bm-reborn-problem__headline-gold{color:#B8956A;}
/* chips bar */
.bm-reborn-problem__chips{background:#FFF9F0;border:1.5px solid rgba(184,149,106,0.25);border-radius:16px;padding:18px 12px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 2px 12px rgba(184,149,106,0.06);}
.bm-reborn-problem__chip{display:flex;flex-direction:column;align-items:center;gap:8px;flex:1;padding:0 12px;font-family:'Heebo',sans-serif;font-size:12px;font-weight:700;color:#3b2c24;text-align:center;position:relative;}
.bm-reborn-problem__chip+.bm-reborn-problem__chip::after{content:'';position:absolute;right:0;top:50%;transform:translateY(-50%);height:40px;width:1px;background:rgba(184,149,106,0.25);}
.bm-reborn-problem__chip svg{color:#B8956A;}
/* body */
.bm-reborn-problem__body{font-family:'Heebo',sans-serif;font-size:15px;font-weight:600;color:#3b2c24;line-height:1.85;margin:0;text-align:center;}
/* callout */
.bm-reborn-problem__callout{background:#FFF9F0;border:1.5px solid rgba(184,149,106,0.25);border-radius:18px;padding:16px 20px;display:flex;align-items:center;gap:14px;flex-direction:row-reverse;box-shadow:0 2px 12px rgba(184,149,106,0.07);}
.bm-reborn-problem__callout-icon{width:44px;height:44px;background:#fff;border-radius:50%;border:1.5px solid rgba(184,149,106,0.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.bm-reborn-problem__callout-text{font-family:'Heebo',sans-serif;font-size:clamp(15px,1.35vw,19px);font-weight:700;color:#1F1B16;margin:0;line-height:1.5;text-align:right;}
.bm-reborn-problem__image-wrap{border-radius:28px;overflow:hidden;box-shadow:0 20px 56px rgba(31,27,22,0.1);}
.bm-reborn-problem__image{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
@media(max-width:768px){
  .bm-reborn-problem{padding:52px 0;}
  .bm-reborn-problem__inner{padding:0 20px;}
  .bm-reborn-problem__grid{grid-template-columns:1fr;gap:28px;}
  .bm-reborn-problem__image-wrap{order:2 !important;}
  .bm-reborn-problem__text{order:1 !important;}
  .bm-reborn-problem__headline{font-size:clamp(24px,6.5vw,32px);}
  .bm-reborn-problem__callout-text{font-size:clamp(16px,4.5vw,20px);}
}
</style>
