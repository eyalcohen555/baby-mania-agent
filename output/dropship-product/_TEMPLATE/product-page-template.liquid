/* ── S7 RESEARCH ── */
.bm-reborn-research{background-color:#F7F2EA;background-image:linear-gradient(rgba(247,242,234,0.68),rgba(247,242,234,0.68)),url('./assets/s7-bg.png');background-size:cover;background-position:center center;background-repeat:no-repeat;padding:88px 0;position:relative;direction:rtl;}
.bm-reborn-research__inner{max-width:1040px;margin:0 auto;padding:0 36px;}
