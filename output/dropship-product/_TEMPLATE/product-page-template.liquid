.bm-reborn-research__source-num{font-family:'Heebo',sans-serif;font-size:26px;font-weight:200;color:rgba(184,149,106,0.35);line-height:1;flex-shrink:0;width:36px;text-align:center;padding-top:4px;}
.bm-reborn-research__source-content{flex:1;display:flex;flex-direction:column;gap:10px;text-align:right;}
.bm-reborn-research__source-header{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;justify-content:flex-start;}
