        {%- if bm_v1 -%}
        <label class="bc-info">
          <input type="radio" name="id" value="{{ bm_v1.id }}" checked>
          <span class="bc-title">{{ bm_v1.title }}</span>
          <span class="bc-price">{{ bm_v1.price | money }}</span>
          {%- if bm_v1.compare_at_price > bm_v1.price -%}
          <span class="bc-old">{{ bm_v1.compare_at_price | money }}</span>
          {%- endif -%}
        </label>
        {%- endif -%}
        {%- if bm_v2 -%}
        <label class="bc-info">
          <input type="radio" name="id" value="{{ bm_v2.id }}">
          <span class="bc-tag hot">🔥 הכי פופולרי</span>
          <span class="bc-title">{{ bm_v2.title }}</span>
          <span class="bc-price">{{ bm_v2.price | money }}</span>
          {%- if bm_v2.compare_at_price > bm_v2.price -%}
          <span class="bc-old">{{ bm_v2.compare_at_price | money }}</span>
          {%- endif -%}
        </label>
        {%- endif -%}
        {%- if bm_v3 -%}
        <label class="bc-info">
          <input type="radio" name="id" value="{{ bm_v3.id }}">
          <span class="bc-tag best">💰 הכי משתלם</span>
          <span class="bc-title">{{ bm_v3.title }}</span>
          <span class="bc-price">{{ bm_v3.price | money }}</span>
          {%- if bm_v3.compare_at_price > bm_v3.price -%}
          <span class="bc-old">{{ bm_v3.compare_at_price | money }}</span>
          {%- endif -%}
        </label>
        {%- endif -%}
      </div>
      <div class="bundle-cta-wrap">
        <button type="submit" class="btn-cta">הוסיפי לעגלה 🛒</button>
      </div>
    </form>
  </div>
</section>

