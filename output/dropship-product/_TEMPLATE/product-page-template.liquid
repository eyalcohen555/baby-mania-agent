{% stylesheet %}
/* ── existing ── */
body { font-family: 'Heebo', sans-serif; }
.shadow-soft { box-shadow: 0 10px 40px -10px rgba(184,149,106,0.15); }
.shadow-hover { box-shadow: 0 20px 40px -10px rgba(184,149,106,0.25); }
.gradient-overlay { background: linear-gradient(180deg,rgba(252,249,248,0) 0%,rgba(252,249,248,0.9) 100%); }
.bg-pattern { background-image: radial-gradient(#b8956a 1px,transparent 1px); background-size: 24px 24px; opacity: 0.1; }
.section-label { font-size: 10px; font-weight: 700; color: rgba(184,149,106,0.5); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 20px; display: flex; align-items: center; gap: 6px; }
.section-label::before { content:''; display:inline-block; width:16px; height:1px; background:rgba(184,149,106,0.4); }

/* ── custom vars ── */
:root {
  --cta:#B8956A; --cta-hover:#9A7B55; --heading:#1A1A1A; --text:#555555;
  --bg:#FFFFFF; --bg-alt:#FAF6F1;
  --save-bg:#E8F5E9; --save-text:#2E7D32;
  --urgency-bg:#FFF8E1; --urgency-text:#E65100;
  --stars:#D4A54A; --max:1140px; --pad:32px;
}
@media(max-width:768px){ :root{ --pad:20px; } }

/* ── shared utilities ── */
.sc { max-width:var(--max); margin:0 auto; padding:0 var(--pad); }
@keyframes shine { 0%{transform:translateX(-150%)} 100%{transform:translateX(250%)} }
.btn-cta {
  display:inline-block; background:var(--cta); color:#fff; font-family:'Heebo',sans-serif;
  font-weight:700; font-size:18px; padding:16px 36px; border-radius:50px; border:none;
  cursor:pointer; text-decoration:none; transition:background .2s,transform .2s;
  position:relative; overflow:hidden;
}
.btn-cta::after {
  content:''; position:absolute; top:0; left:-60%; width:40%; height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.35),transparent);
  animation:shine 2.4s infinite;
}
.btn-cta:hover { background:var(--cta-hover); transform:translateY(-2px); }
.btn-outline {
  display:inline-block; background:transparent; color:var(--cta); font-family:'Heebo',sans-serif;
  font-weight:700; font-size:18px; padding:14px 36px; border-radius:50px;
  border:2px solid var(--cta); cursor:pointer; text-decoration:none; transition:background .2s,color .2s;
}
.btn-outline:hover { background:var(--cta); color:#fff; }
.sec-lbl {
  font-size:10px; font-weight:700; color:rgba(184,149,106,0.5); text-transform:uppercase;
  letter-spacing:0.8px; margin-bottom:20px; display:flex; align-items:center; gap:6px;
}
.sec-lbl::before { content:''; display:inline-block; width:16px; height:1px; background:rgba(184,149,106,0.4); }
.sec-lbl.center { justify-content:center; }

/* ── S1 HERO ── */
.hero-sec { background:var(--bg); padding:80px 0; }
.hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; }
@media(max-width:768px){ .hero-grid{grid-template-columns:1fr;gap:32px;} .hero-img-col{order:-1;} }
.hero-tag { display:inline-block; background:var(--bg-alt); color:var(--cta); font-size:13px; font-weight:700; padding:6px 16px; border-radius:20px; margin-bottom:14px; }
.hero-prod-name { font-size:14px; color:var(--cta); font-weight:500; margin-bottom:10px; }
.hero-h1 { font-size:clamp(26px,3.5vw,42px); font-weight:900; color:var(--heading); line-height:1.25; margin-bottom:18px; }
.hero-sub { font-size:16px; color:var(--text); line-height:1.75; margin-bottom:22px; }
.hero-stars { display:flex; align-items:center; gap:8px; flex-direction:row-reverse; justify-content:flex-start; margin-bottom:22px; }
.stars-ico { color:var(--stars); font-size:20px; letter-spacing:2px; }
.hero-rating { font-weight:700; font-size:16px; color:var(--heading); }
.hero-review-count { font-size:14px; color:var(--text); text-decoration:underline; cursor:pointer; }
.hero-price-row { display:flex; align-items:center; gap:12px; flex-direction:row-reverse; justify-content:flex-start; margin-bottom:6px; }
.price-now { font-size:34px; font-weight:900; color:var(--heading); }
.price-old { font-size:20px; color:#aaa; text-decoration:line-through; }
.price-save { background:var(--save-bg); color:var(--save-text); font-size:13px; font-weight:700; padding:4px 12px; border-radius:20px; }
.hero-daily { font-size:14px; color:var(--text); margin-bottom:26px; text-align:right; }
.hero-btns { display:flex; gap:16px; flex-direction:row-reverse; flex-wrap:wrap; margin-bottom:28px; }
/* ── S1 TRUST BAR ── */
.hero-trust { display:flex; gap:10px; flex-wrap:wrap; opacity:0; transform:translateY(14px); transition:opacity .55s ease,transform .55s ease; }
.hero-trust.bm-trust--visible { opacity:1; transform:translateY(0); }
.hero-trust-item { display:flex; flex-direction:column; align-items:center; text-align:center; gap:6px; flex:1; min-width:0; background:rgba(255,255,255,0.72); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); border:1px solid rgba(139,94,60,0.1); border-radius:14px; padding:12px 8px; box-sizing:border-box; transition:transform .25s ease,box-shadow .25s ease; }
.hero-trust-item:hover { transform:translateY(-3px); box-shadow:0 8px 22px rgba(139,94,60,0.1); }
.hero-trust-icon { width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.hero-trust-icon svg { width:19px; height:19px; fill:none; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
.hero-trust-icon--green { background:radial-gradient(circle at 38% 35%,#fff 0%,#E8F5E9 55%,#c8e6c9 100%); box-shadow:0 3px 10px rgba(76,175,80,0.18),inset 0 1px 3px rgba(255,255,255,0.85); }
.hero-trust-icon--green svg { stroke:#43A047; }
.hero-trust-icon--blue { background:radial-gradient(circle at 38% 35%,#fff 0%,#E3F2FD 55%,#bbdefb 100%); box-shadow:0 3px 10px rgba(33,150,243,0.18),inset 0 1px 3px rgba(255,255,255,0.85); }
.hero-trust-icon--blue svg { stroke:#1E88E5; }
.hero-trust-icon--amber { background:radial-gradient(circle at 38% 35%,#fff 0%,#FFF3E0 55%,#ffe0b2 100%); box-shadow:0 3px 10px rgba(255,152,0,0.18),inset 0 1px 3px rgba(255,255,255,0.85); }
.hero-trust-icon--amber svg { stroke:#FB8C00; }
.hero-trust-label { font-size:13px; font-weight:700; color:#1A1A1A; line-height:1.3; }
.hero-trust-sub { font-size:11px; font-weight:400; color:#9E8272; line-height:1.4; }
@media(max-width:520px) {
  .hero-trust { gap:6px; flex-wrap:nowrap; }
  .hero-trust-item { padding:9px 6px; gap:5px; }
  .hero-trust-icon { width:38px; height:38px; }
  .hero-trust-icon svg { width:16px; height:16px; }
  .hero-trust-label { font-size:11.5px; }
  .hero-trust-sub { display:none; }
}
.hero-img-ph { width:100%; aspect-ratio:4/5; background:#F5EFE8; border:2px dashed rgba(184,149,106,0.3); border-radius:32px; display:flex; align-items:center; justify-content:center; color:rgba(184,149,106,0.6); font-size:14px; text-align:center; padding:20px; line-height:1.6; }
.hero-img { width:100%; aspect-ratio:4/5; object-fit:cover; border-radius:32px; display:block; }

/* ── S2 BUNDLE ── */
.bundle-sec { position:relative; background:url('{{ IMG_S2_BUNDLE }}') center/cover no-repeat; padding:80px 0; }
.bundle-sec::before { content:''; position:absolute; inset:0; background:rgba(255,255,255,0.6); pointer-events:none; z-index:0; }
.bundle-sec > .sc { position:relative; z-index:1; }
.bundle-sec h2 { font-size:clamp(22px,3vw,34px); font-weight:900; color:var(--heading); text-align:right; margin-bottom:12px; }
.bundle-sub { font-size:16px; color:var(--text); text-align:right; margin-bottom:36px; line-height:1.7; }
.bundle-opts { display:flex; flex-direction:column; gap:14px; max-width:580px; margin:0 auto 28px; }
.bundle-card { background:#fff; border:2px solid #E5DCCE; border-radius:16px; padding:18px 22px; cursor:pointer; transition:border-color .2s,background .2s; display:flex; align-items:center; gap:14px; flex-direction:row-reverse; }
.bundle-card.selected { border-color:var(--cta); background:#FDF9F4; }
.bundle-card input[type=radio] { accent-color:var(--cta); width:20px; height:20px; flex-shrink:0; }
.bc-info { flex:1; text-align:right; }
.bc-title { font-size:16px; font-weight:700; color:var(--heading); margin-bottom:3px; }
.bc-price { font-size:20px; font-weight:900; color:var(--cta); }
.bc-old { font-size:14px; color:#aaa; text-decoration:line-through; margin-right:6px; }
.bc-pct { font-size:13px; font-weight:700; color:var(--save-text); margin-right:6px; }
.bc-perks { font-size:13px; color:var(--text); margin-top:4px; }
.bc-tag { font-size:11px; font-weight:700; padding:4px 10px; border-radius:12px; white-space:nowrap; flex-shrink:0; }
.bc-tag.hot { background:#FFF3E0; color:#E65100; }
.bc-tag.best { background:var(--save-bg); color:var(--save-text); }
.bundle-cta-wrap { text-align:center; }

/* ── S3 TRUST IMAGE ── */
.s3-img-sec { line-height:0; }
.s3-img-sec .s3-desktop { display:block; width:100%; }
.s3-img-sec .s3-mobile  { display:none;  width:100%; }
@media(max-width:768px){
  .s3-img-sec .s3-desktop { display:none; }
  .s3-img-sec .s3-mobile  { display:block; }
}

/* ── S6 BENEFITS (Stitch) ── */
.bm-reborn-benefits-section {
  font-family:'Heebo',sans-serif;
  background-color:#fcf9f2;
  background-image: linear-gradient(rgba(255,255,255,0.6),rgba(255,255,255,0.6)), url('./assets/s6-bg-mobile.png');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  color:#4a3c31; padding:4rem 1.5rem 6rem;
  position:relative; overflow:hidden; box-sizing:border-box;
}
.bm-reborn-benefits-section *,.bm-reborn-benefits-section *::before,.bm-reborn-benefits-section *::after { box-sizing:inherit; }
.bm-reborn-benefits-bg-element { position:absolute; border-radius:50%; z-index:0; filter:blur(40px); }
.bm-reborn-benefits-bg-element-1 { background:radial-gradient(circle,rgba(184,149,106,0.15) 0%,transparent 70%); width:800px; height:800px; top:-200px; right:-200px; }
.bm-reborn-benefits-bg-element-2 { background:radial-gradient(circle,rgba(229,211,179,0.2) 0%,transparent 70%); width:1000px; height:1000px; bottom:-300px; left:-300px; }
.bm-reborn-benefits-bg-element-3 { position:absolute; top:0; left:0; right:0; bottom:0; opacity:0.03; background-image:url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23b8956a' fill-opacity='1' fill-rule='evenodd'/%3E%3C%2Fsvg%3E"); z-index:0; pointer-events:none; }
.bm-reborn-benefits-hero-image-wrapper { display:none; }
.bm-reborn-benefits-container { position:relative; z-index:1; max-width:1400px; margin:0 auto; }
.bm-reborn-benefits-header { text-align:center; margin-bottom:4rem; position:relative; }
.bm-reborn-benefits-subtitle { display:inline-flex; align-items:center; justify-content:center; gap:1rem; color:#b8956a; font-size:1.1rem; font-weight:500; margin-bottom:1.5rem; }
.bm-reborn-benefits-subtitle::before,.bm-reborn-benefits-subtitle::after { content:''; display:block; width:60px; height:1px; background-color:#d2b48c; }
.bm-reborn-benefits-title { font-size:3rem; font-weight:900; color:#3b2c24; margin:0; line-height:1.1; letter-spacing:-0.02em; }
.bm-reborn-benefits-title-icon { display:block; margin:1rem auto 0; width:24px; height:24px; fill:#b8956a; }
.bm-reborn-benefits-grid { display:grid; grid-template-columns:1fr; gap:2rem; max-width:1200px; margin:0 auto; }
.bm-reborn-benefits-card { background:rgba(255,252,248,0.85); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border:2px solid rgba(255,255,255,0.8); border-radius:32px; padding:2.5rem; display:flex; flex-direction:column; align-items:center; text-align:center; box-shadow:0 20px 50px rgba(184,149,106,0.08),inset 0 0 0 1px rgba(184,149,106,0.1); transition:transform .4s cubic-bezier(.165,.84,.44,1),box-shadow .4s cubic-bezier(.165,.84,.44,1); position:relative; overflow:hidden; }
.bm-reborn-benefits-card::before { content:''; position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(135deg,rgba(255,255,255,0.4) 0%,rgba(255,255,255,0) 100%); border-radius:32px; pointer-events:none; }
.bm-reborn-benefits-card:hover { transform:translateY(-8px); box-shadow:0 30px 60px rgba(184,149,106,0.12),inset 0 0 0 1px rgba(184,149,106,0.2); }
.bm-reborn-benefits-card-icon-wrapper { width:110px; height:110px; border-radius:50%; background:linear-gradient(135deg,#ffffff 0%,#f9f3e9 100%); display:flex; align-items:center; justify-content:center; margin-bottom:2rem; box-shadow:0 15px 30px rgba(184,149,106,0.15),inset 0 4px 8px #fff,inset 0 -4px 8px rgba(184,149,106,0.05); border:4px solid #fff; position:relative; z-index:1; }
.bm-reborn-benefits-card-icon { width:50px; height:50px; stroke:#b8956a; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
.bm-reborn-benefits-card-content { position:relative; z-index:1; }
.bm-reborn-benefits-card-title { font-size:1.5rem; font-weight:800; color:#3b2c24; margin:0 0 1rem; display:flex; align-items:center; justify-content:center; gap:.75rem; }
.bm-reborn-benefits-card-title svg { width:16px; height:16px; fill:#cda97e; }
.bm-reborn-benefits-card-text { font-size:1.1rem; line-height:1.7; color:#5c4e43; margin:0; max-width:320px; }
.bm-reborn-benefits-intro {
  font-family:'Heebo',sans-serif;
  font-size:18px; font-weight:600; color:#2A1800; line-height:1.85;
  max-width:700px; margin:2rem auto 0; text-align:center;
  background:rgba(255,252,248,0.88);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(184,149,106,0.18);
  border-radius:20px;
  padding:22px 36px;
  box-shadow:0 8px 32px rgba(184,149,106,0.09), inset 0 1px 0 rgba(255,255,255,0.65);
}
.bm-reborn-benefits-card-text+.bm-reborn-benefits-card-text { margin-top:10px; }
[data-section="8"] .bm-reborn-benefits-card-text { max-width:none; text-align:right; direction:rtl; color:#2A2118; }
.bm-reborn-benefit__outcome { font-weight:700; color:#7B5A34; margin-top:12px; line-height:1.75; }
/* Hero image */
.bm-reborn-benefits-hero-img { width:100%; height:100%; object-fit:cover; border-radius:43% 57% 65% 35% / 46% 62% 38% 54%; -webkit-mask-image:radial-gradient(circle at 40% 40%,black 55%,transparent 100%); mask-image:radial-gradient(circle at 40% 40%,black 55%,transparent 100%); }
@keyframes bm-reborn-blob-anim { 0%{border-radius:43% 57% 65% 35% / 46% 62% 38% 54%} 50%{border-radius:53% 47% 45% 55% / 56% 42% 58% 44%} 100%{border-radius:43% 57% 65% 35% / 46% 62% 38% 54%} }
[data-section="10"].bm-reborn-benefits-section {
  background-image: linear-gradient(rgba(255,255,255,0.6),rgba(255,255,255,0.6)), url('{{ IMG_S2_BUNDLE }}');
}
@media(min-width:768px){
  .bm-reborn-benefits-section { padding:6rem 3rem 8rem; background-image:linear-gradient(rgba(255,255,255,0.6),rgba(255,255,255,0.6)),url('./assets/s6-bg-desktop.png'); background-size:cover; background-position:center center; }
  [data-section="10"].bm-reborn-benefits-section { background-image:linear-gradient(rgba(255,255,255,0.6),rgba(255,255,255,0.6)),url('{{ IMG_S2_BUNDLE }}'); }
  .bm-reborn-benefits-header { margin-bottom:6rem; }
  .bm-reborn-benefits-title { font-size:4.5rem; }
  .bm-reborn-benefits-grid { grid-template-columns:1fr 260px 1fr; gap:2rem; }
  .bm-reborn-benefits-card:nth-child(1) { grid-column:1; grid-row:1; }
  .bm-reborn-benefits-card:nth-child(2) { grid-column:3; grid-row:1; }
  .bm-reborn-benefits-card:nth-child(3) { grid-column:1; grid-row:2; }
  .bm-reborn-benefits-card:nth-child(4) { grid-column:3; grid-row:2; }
