        "text_KMtrQn": {
          "type": "text",
          "settings": {
            "text": "<p>ברוכים הבאים לחנות המקוונת שלנו<br\/>הקמתי את החנות מתוך הצורך האישי שלי בבגדי ילדים איכותיים ויפים במחירים נגישים לכל כיס.<br\/>תוכלו למצוא אצלנו מבחר גדול של בגדים איכותיים, נוחים, מלאים בסטייל ושיק ממידה ניו בורן ועד גילאי בית ספר.<\/p><p><br\/>שמנו דגש מיוחד על בגדים נוחים מבדים איכותיים שמתאימים לעור העדין והרך של ילדינו. <\/p><p><br\/>אנחנו כאן לספק לכם חווית קנייה ושירות שתשאיר טעם של עוד ומתרגשים לצרף אתכם למעגל הלקוחות שלנו.<\/p>"
          }
        },
        "button_wq6FrQ": {
          "type": "button",
          "disabled": true,
          "settings": {
            "button_label": "Button label",
